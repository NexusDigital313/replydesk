# ── Claude (optional) ──────────────────────────────────────────────
# With a key, Pro replies are drafted by Claude (claude-opus-4-8).
# Without it, the built-in local engine is used everywhere.
ANTHROPIC_API_KEY=

# ── Paywall / plan gating ──────────────────────────────────────────
# The plan UI (Free vs Pro, usage limits, upgrade) is ON by default.
# Set to 0 to disable gating and give everyone Pro (e.g. internal use).
NEXT_PUBLIC_PAYWALL=1

# Signs license tokens issued after a successful Stripe payment. Set this
# (any long random string) to make the paywall actually enforce Pro on the
# server. If unset, the paywall is "soft" (UI only) and Claude is ungated.
LICENSE_SECRET=

# ── Stripe (optional — required to charge real money) ──────────────
# Subscription price for Pro. Create a recurring Price in the Stripe
# dashboard and paste its id here.
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=

# Public base URL used for Stripe redirect URLs (defaults to the request
# origin if unset). Set in production, e.g. https://replydesk.com
NEXT_PUBLIC_APP_URL=

# ── Instant revocation (optional — needs Stripe billing above) ─────
# Without these, a cancelled subscription loses Pro on the user's next visit
# (≤2 days). With them, the Stripe webhook revokes access instantly.
#
# Stripe webhook signing secret. In Stripe → Developers → Webhooks, add an
# endpoint at https://YOUR_DOMAIN/api/stripe/webhook subscribed to
# customer.subscription.deleted, .updated and .paused, then paste its secret.
STRIPE_WEBHOOK_SECRET=

# Vercel KV (Upstash Redis) REST credentials — records which subscriptions are
# revoked. Create a KV store in the Vercel dashboard, link it to the project,
# and these populate automatically (run `vercel env pull` for local dev).
KV_REST_API_URL=
KV_REST_API_TOKEN=

# ── Google Business Profile import (optional) ──────────────────────
# OAuth client for "Connect Google". Live review sync also requires your
# app to be approved for the Google Business Profile API. The paste / CSV
# importer works without any of this.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
