# ── Claude (optional) ──────────────────────────────────────────────
# With a key, Pro replies are drafted by Claude (claude-opus-4-8).
# Without it, the built-in local engine is used everywhere. Pro users
# bring their own key in the app, so this is mainly for self-host / dev.
ANTHROPIC_API_KEY=

# ── Paywall / plan gating ──────────────────────────────────────────
# The plan UI (Free vs Pro, usage limits, upgrade) is ON by default.
# Set to 0 to disable gating and give everyone Pro (e.g. internal use).
NEXT_PUBLIC_PAYWALL=1

# ── Lemon Squeezy (required to charge real money) ──────────────────
# ReplyDesk Pro is sold through Lemon Squeezy (Merchant of Record — they
# handle VAT/sales tax). The buyer pays on LS's hosted checkout, gets a
# license key by email, and pastes it into the app. The app validates the
# key directly against LS's public license API from the browser — no
# ReplyDesk server is in the billing path.
#
# Pro is sold two ways — a $19/mo monthly and a $149/yr annual (2 months
# free). Create BOTH in Lemon Squeezy; a license from either unlocks the app.
# Numeric store id, shared by both (Settings → Stores):
NEXT_PUBLIC_LS_STORE_ID=
# Monthly — Product → Share → "Buy" link + the product's numeric id:
NEXT_PUBLIC_LS_CHECKOUT_URL_MONTHLY=
NEXT_PUBLIC_LS_PRODUCT_ID_MONTHLY=
# Annual — same, for the yearly product:
NEXT_PUBLIC_LS_CHECKOUT_URL_ANNUAL=
NEXT_PUBLIC_LS_PRODUCT_ID_ANNUAL=

# ── Google Business Profile import (optional) ──────────────────────
# OAuth client for "Connect Google". Live review sync also requires your
# app to be approved for the Google Business Profile API. The paste / CSV
# importer works without any of this.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
